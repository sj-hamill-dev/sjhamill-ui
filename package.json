{
  "name": "@sjhamill/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design system + UI primitives for SJ Hamill internal frontends.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./tailwind-preset.js",
    "./styles/globals.css": "./src/styles/globals.css",
    "./lib/utils": "./src/lib/utils.ts"
  },
  "files": [
    "src",
    "tailwind-preset.js",
    "README.md",
    "ADOPTION.md"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tailwind-preset.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tailwind-preset.js\" \"*.json\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0"
  }
}
